            .docker-logo { font-family: monospace; color: #2496ed; white-space: pre; font-size: 12px; }
        </style>
    </head>
    <body>
        <div class="container">
            <pre class="docker-logo">
               ##         .
         ## ## ##        ==
      ## ## ## ## ##    ===
   /""""""""""""""""\___/ ===
  {                       /  ===-
   \______ O           __/
    \    \         __/
     \____\_______/
            </pre>
            <h1>Dockerized Python App!</h1>
            <p>This app is running inside a Docker container on GCP!</p>
            <p>Total Visitors: """ + str(count) + """</p>
            <p>Built by Moses Chukwuma</p>
            <p>
                <a href="/about">About</a> |
                <a href="/contact">Contact</a> |
                <a href="/sign-in">Sign In</a> |
                <a href="/visitors">Visitors</a> |
                <a href="/search">Search</a>
            </p>
            <p><small>Powered by Flask + Debian 13 + Docker</small></p>
        </div>
